{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/about", "destination": "/index.html"},
    {"source": "/expertise", "destination": "/index.html"},
    {"source": "/projects", "destination": "/index.html"},
    {"source": "/projects/:slug", "destination": "/index.html"},
    {"source": "/insights", "destination": "/index.html"},
    {"source": "/insights/:slug", "destination": "/index.html"},
    {"source": "/contact", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}
  ]
}